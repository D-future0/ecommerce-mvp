# Neon PostgreSQL: use the pooled URL for app queries and the direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Optional source database connection for the one-time migration utility only.
MONGODB_URI="mongodb+srv://USER:PASSWORD@HOST/DATABASE"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
REDIS_URL="redis://localhost:6379"

PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@example.com"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

ADMIN_EMAIL=""
ADMIN_PASSWORD=""
